# Copy to 06_AI_Mode_II_CAD/extractor_and_manifest/.env (git-ignored) OR pass --env-file <path>.
# NEVER commit .env, paste keys into chat, or put keys in code.
# Onshape > My account > Developer > API keys (read scope is enough).
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=
# hmac (default, signed requests) | basic | anonymous
ONSHAPE_AUTH_MODE=hmac
# Optional: freeze a NAMED VERSION instead of the workspace, e.g.
# APSD_LATHE_URL=https://cad.onshape.com/documents/<did>/v/<vid>/e/147da5f19a2ac767328e5f7f
# APSD_MILLING_URL=https://cad.onshape.com/documents/<did>/v/<vid>/e/20caaefd66e3a40229321161
